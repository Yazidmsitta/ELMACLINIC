SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Server only: legacy service_role JWT (used for Admin API and rate-limit RPC).
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random characters; hashes rate-limit identifiers.
RATE_LIMIT_SECRET=
# Explicitly true ONLY behind Vercel's trusted ingress. Otherwise one shared IP bucket.
TRUST_VERCEL_PROXY=false
# Used only by the local provisioning script; not deployed.
ALLOW_DEMO_PROVISIONING=false
DEMO_PASSWORD=

# Website receiver stays disabled until the sender and HTTPS deployment are configured.
WEBSITE_WEBHOOK_ENABLED=false
# Dedicated 32 random bytes encoded as 64 hex characters; server-only.
WEBSITE_WEBHOOK_SECRET_HEX=

# Future website server-to-server catalog; use a separate key from booking delivery.
WEBSITE_CATALOG_ENABLED=false
WEBSITE_CATALOG_SECRET_HEX=
